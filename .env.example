# Prism Engine Environment Variables

# App
APP_NAME="Prism Engine"
APP_VERSION="1.0.0"
DEBUG=false
DEMO_MODE=false

# Server
HOST="127.0.0.1"
PORT=8000

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./prism.db"

# Security
SECRET_KEY="dev-secret-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC/Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL="http://localhost:8080/realms/prism-engine"
OIDC_CLIENT_ID="prism-engine"
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:3000/auth/callback"
OIDC_SCOPES="openid profile email roles"
OIDC_AUDIENCE="prism-engine"

# Demo Mode OIDC (local only)
DEMO_OIDC_ISSUER_URL="http://localhost:8080/realms/prism-engine"
DEMO_OIDC_CLIENT_ID="prism-engine-demo"
DEMO_OIDC_CLIENT_SECRET="demo-secret"
DEMO_OIDC_REDIRECT_URI="http://localhost:3000/auth/callback"

# LLM Providers
LLM_API_KEY=""
LLM_PROVIDER="openai-compatible"
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
LLM_TIMEOUT=30.0

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Keycloak Admin
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
KEYCLOAK_ADMIN_URL="http://localhost:8080/admin"